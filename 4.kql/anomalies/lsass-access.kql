// ===============================
// ADVANCED LSASS ACCESS ANOMALY DETECTION
// Technique: T1003 (Credential Dumping)
// ===============================

// 1. Suspicious LSASS access via process handles
let LsassHandleAccess =
DeviceProcessEvents
| where FileName =~ "lsass.exe"
| join kind=inner (
    DeviceProcessEvents
    | where GrantedAccess has_any ("0x40", "0x1000", "0x1FFFFF")
    | project Timestamp, DeviceName, FileName, ProcessCommandLine, InitiatingProcessFileName, GrantedAccess
) on DeviceName
| project Timestamp, DeviceName, FileName, ProcessCommandLine, InitiatingProcessFileName, GrantedAccess;

// 2. Known credential dumping tools
let KnownDumpTools =
DeviceProcessEvents
| where FileName in ("procdump.exe", "rundll32.exe", "comsvcs.dll")
| project Timestamp, DeviceName, FileName, ProcessCommandLine, InitiatingProcessFileName;

// 3. LSASS memory read anomalies
let MemoryReadAnomalies =
DeviceEvents
| where ActionType == "ProcessMemoryRead"
| where TargetProcessName =~ "lsass.exe"
| project Timestamp, DeviceName, TargetProcessName, InitiatingProcessFileName, AdditionalFields;

// Combine anomalies
LsassHandleAccess
| union KnownDumpTools
| union MemoryReadAnomalies
| order by Timestamp desc
