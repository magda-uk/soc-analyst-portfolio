// -------------------------------------------------------------------------
// Rule Name: LSASS Credential Dumping via Process Command Line
// Platform: Microsoft Sentinel / Microsoft Defender for Endpoint (MDE)
// Description: Identifies suspicious tools and command lines accessing LSASS memory.
// -------------------------------------------------------------------------

DeviceProcessEvents
| where FileName in~ ("mimikatz.exe", "procdump.exe", "rundll32.exe") 
   or ProcessCommandLine has_any ("sekurlsa", "lsass.dmp", "comsvcs.dll")
| project Timestamp, DeviceName, FileName, ProcessCommandLine, InitiatingProcessFileName, ParentProcessName